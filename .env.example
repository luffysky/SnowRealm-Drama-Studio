# ---------------------------------------------------------------------------
# SnowRealm Drama Studio — environment variables
#
# Copy to .env.local for local development, and set the same keys in Vercel.
# Full instructions for obtaining every value: docs/ENVIRONMENT.md
#
# No variable here may ever be prefixed with NEXT_PUBLIC_ — that would compile
# the value into the browser bundle and publish your database and storage keys.
# ---------------------------------------------------------------------------

# --- Neon PostgreSQL -------------------------------------------------------
# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=

# Direct / unpooled connection (host does NOT contain "-pooler").
# Used by drizzle-kit migrations only; PgBouncer cannot serve them.
DATABASE_URL_UNPOOLED=

# Database the destructive suites use (`npm test`, `npm run test:smoke`). They
# truncate tables and reset password hashes, so they refuse to run against a
# Neon host. Set this to a local cluster — `npm run db:local` — when
# DATABASE_URL points at a deployment, otherwise those tests skip.
#   postgresql://srds:srds_local_dev@127.0.0.1:55432/snowrealm_drama_studio
TEST_DATABASE_URL=

# --- Authentication --------------------------------------------------------
# Signs the session cookie. Generate your own, never reuse an example value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- Cloudflare R2 (S3-compatible object storage) --------------------------
# Cloudflare account ID (32 hex characters), shown on the R2 overview page.
R2_ACCOUNT_ID=

# From R2 -> Manage R2 API Tokens -> Create API token.
# Permission: "Object Read & Write", scoped to this bucket only.
# The secret is displayed exactly once at creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket holding every uploaded asset. Keep it private: do not enable the
# r2.dev public development URL and do not attach a custom domain.
R2_BUCKET=

# Optional. Overrides the S3 endpoint; derived from R2_ACCOUNT_ID when empty.
R2_ENDPOINT=

# Optional. Lifetime of presigned upload/download URLs in seconds (default 300).
PRESIGN_TTL_SECONDS=

# --- AI ---------------------------------------------------------------------
# Claude API key, from https://console.anthropic.com
# Optional: without it, AI features show an explicit "not configured" state and
# every other feature works normally. A key entered through the provider
# settings dialog is stored encrypted in the database and takes precedence.
ANTHROPIC_API_KEY=

# Optional. Encrypts AI provider keys at rest (AES-256-GCM). When unset, a key
# is derived from AUTH_SECRET instead — which means rotating AUTH_SECRET would
# also invalidate stored provider keys. Set this to decouple the two.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=

# --- Search (embeddings) ---------------------------------------------------
# Voyage AI key. Voyage was acquired by MongoDB and the standalone dashboard no
# longer issues keys: create one in MongoDB Atlas (cloud.mongodb.com) under
# Services -> Model API Keys. See docs/SEARCH.md §5 for the click path.
#
# The key's prefix decides the host, and the app routes it automatically:
#   al-…      Atlas, unscoped        -> ai.mongodb.com
#   al-eu-…   Atlas, Europe only     -> eu.ai.mongodb.com
#   al-us-…   Atlas, US only         -> us.ai.mongodb.com
#   pa-…      legacy voyageai.com    -> api.voyageai.com
#
# Optional: without it the top-right search still works, but keyword-only
# (trigram + containment). With it, the same box does semantic retrieval —
# a description of a scene finds the scene even when none of those words
# appear in it.
VOYAGE_API_KEY=

# Optional. Defaults to voyage-4 (1024 dimensions). Changing this invalidates
# every stored embedding: the next reindex re-embeds everything, at cost.
VOYAGE_MODEL=

# Optional. Overrides the host above (a proxy, or a future endpoint). Include
# the version segment, e.g. https://ai.mongodb.com/v1
VOYAGE_BASE_URL=

# --- Initial accounts ------------------------------------------------------
# Used by `npm run db:seed` only. Passwords are hashed with Argon2id before
# storage and are never written to a log.
# Safe to delete from Vercel once the two accounts exist.
# Owner        = full access, plus member management and project deletion.
# Collaborator = full access to production content, no member management.
#
# ACCOUNT is the short login handle (letters, digits, . _ -, 3–32 chars) typed
# instead of the email address. Both sign a member in; the handle is matched
# case-insensitively. It does not have to resemble the email.
#
# Minimum password length is 8 (src/lib/auth/password.ts).
#
# NOTE: db:seed upserts on EMAIL. Changing SEED_*_EMAIL later creates a second
# account rather than renaming the first — use these instead:
#   npm run account:password -- --email <handle or email> [--new-email <new>]
#   npx tsx scripts/prune-users.ts --email <old email> --apply
SEED_OWNER_EMAIL=
SEED_OWNER_ACCOUNT=
SEED_OWNER_NAME=
SEED_OWNER_TITLE=
SEED_OWNER_PASSWORD=
SEED_COLLABORATOR_EMAIL=
SEED_COLLABORATOR_ACCOUNT=
SEED_COLLABORATOR_NAME=
SEED_COLLABORATOR_TITLE=
SEED_COLLABORATOR_PASSWORD=

# --- Background worker ------------------------------------------------------
# Bearer token Vercel Cron presents to /api/ai/worker. Without it the worker
# endpoint returns 503 and AI jobs stay queued — it fails closed, not open.
# Vercel sets this automatically for cron invocations when you add it here.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
