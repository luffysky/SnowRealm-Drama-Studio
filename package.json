    "db:reset": "tsx scripts/reset-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:purge-uploads": "tsx scripts/purge-stale-uploads.ts",
    "account:password": "tsx scripts/set-password.ts",
    "account:check": "tsx scripts/check-accounts.ts",
    "r2:check": "tsx scripts/r2-check.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:api": "tsx scripts/check-api-wiring.ts",
    "check:ai": "tsx scripts/check-ai-tasks.ts",
    "check": "npm run typecheck && npm run lint && npm run check:links && npm run check:api && npm run check:ai && npm run test"
  },
